<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <interface name="kimodo::motion" label="Kimodo Motion" icon="SOP_kinefx-rigpose" showNetworkNavigationBar="false" help_url="">
    <script><![CDATA[from kimodo_motion import panel_parts as kimodo_panel

ui = None

def onCreateInterface():
    global ui
    ui = kimodo_panel.KimodoPanel()
    return ui

def onDestroyInterface():
    global ui
    if ui is not None:
        ui.close_panel()
    ui = None

def onNodePathChanged(node):
    if ui is not None:
        ui.set_node(node)
]]></script>
    <showInParametersPane optype="Sop/kimodo_motion"/>
    <help><![CDATA[]]></help>
  </interface>
</pythonPanelDocument>
